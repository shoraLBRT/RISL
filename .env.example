# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Домен для HTTPS. Для локального запуска без сертификата подойдёт :80
SITE_ADDRESS=example.org

# Порт, на котором приложение доступно напрямую (в обход прокси)
APP_PORT=8080

# Учётные данные единственного администратора.
# Соль и хеш печатает команда:
#   dotnet run --project RISL.Blazor -- hash-password <ваш-пароль>
ADMIN_LOGIN=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
