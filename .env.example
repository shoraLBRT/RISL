# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Домен для HTTPS. Для локального запуска без сертификата подойдёт :80
SITE_ADDRESS=example.org

# Порт на петле сервера, через который прокси стучится в приложение.
# Наружу этот порт не смотрит.
APP_PORT=8080

# Имена, на которые приложение согласно отвечать. Локально подойдёт *,
# на сервере укажите домен: example.org
ALLOWED_HOSTS=*

# Хранить ли исходники загруженных видео. На сервере оставьте true:
# исходники ложатся в data/media/originals, откуда их по расписанию
# забирает в S3 задача из docs/operations.md. False — исходники
# удаляются сразу после перекодирования, архива не будет.
MEDIA_KEEP_ORIGINALS=true

# Учётные данные единственного администратора.
# Обе строки целиком печатает команда:
#   dotnet run --project RISL.Blazor -- hash-password <ваш-пароль>
ADMIN_LOGIN=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
