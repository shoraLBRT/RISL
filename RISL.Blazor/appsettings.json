{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Path": "data/risl.db",
    "MigrateOnStartup": true,
    "SeedSampleData": false
  },

  "Media": {
    "RootPath": "data/media",
    "KeepOriginals": true,
    "MaxUploadBytes": 536870912,
    "PublicPathPrefix": "/media"
  },

  "Ffmpeg": {
    "Path": "ffmpeg",
    "ProbePath": "ffprobe",
    "MaxWidth": 1280,
    "Crf": 24,
    "Preset": "medium",
    "PosterSecond": 1,
    "TimeoutSeconds": 600
  },

  "Admin": {
    "Login": "",
    "PasswordSalt": "",
    "PasswordHash": ""
  }
}
