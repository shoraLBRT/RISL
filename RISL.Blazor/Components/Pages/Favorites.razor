@page "/favorites"
@inject IWordSearchIndex Index

@* Избранное живёт в браузере, без аккаунтов и серверного хранения. Список
   идентификаторов приходит обычной формой, а карточки рисует сервер — теми же
   компонентами, что и на главной. *@

<PageTitle>Избранное — РИЖЯ</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<h1>Избранное</h1>

@* Идентификаторы уходят обычной GET-формой — так же, как поиск на главной.
   Список оказывается в адресной строке, а не в теле POST, поэтому обновление
   страницы просто повторяет тот же GET, без предупреждения о повторной отправке. *@
<form method="get" action="/favorites" data-favorites-form hidden="@Submitted">
    <input type="hidden" name="ids" value="" data-favorites-ids />
</form>

@if (Submitted)
{
    <p class="result-count">Сохранённых слов: @_result.TotalCount</p>

    <WordGrid Items="_result.Items"
              EmptyText="Сохранённые слова больше не найдены — возможно, их удалили из словаря." />
}
else
{
    @* Пока скрипт не подставил идентификаторы, форма отправляется сама.
       Если JavaScript выключен, гость видит объяснение, а не пустое ожидание. *@
    <noscript>
        <div class="empty-state">
            Избранное хранится в браузере и требует включённого JavaScript.
        </div>
    </noscript>

    <div class="empty-state" data-favorites-pending hidden>
        Вы пока ничего не сохранили. Нажмите звёздочку на карточке слова, чтобы добавить его сюда.
    </div>
}

@code {
    // Избранное — это десятки слов, а не тысячи, поэтому показываем список целиком:
    // постраничные ссылки здесь всё равно потеряли бы отправленные формой идентификаторы.
    private const int MaxFavorites = 500;

    private SearchResult _result = SearchResult.Empty;
    private bool Submitted => IdsValue is not null;

    [SupplyParameterFromQuery(Name = "ids")]
    public string? IdsValue { get; set; }

    protected override void OnParametersSet()
    {
        if (IdsValue is null)
        {
            return;
        }

        var ids = IdsValue
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => int.TryParse(value, out var parsed) ? parsed : (int?)null)
            .OfType<int>()
            .Take(MaxFavorites)
            .ToHashSet();

        _result = ids.Count == 0
            ? SearchResult.Empty
            : Index.Search(new SearchQuery { Ids = ids, PageSize = MaxFavorites });
    }
}
