@page "/admin/categories"
@layout AdminLayout
@using RISL.Blazor.Security
@attribute [Authorize(Policy = AdminAuthentication.Policy)]
@inject ICategoryAdminService CategoryService

<PageTitle>Темы — панель словаря</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<h1>Темы</h1>

@if (Saved)
{
    <div class="alert alert--success">Сохранено.</div>
}

@if (Deleted)
{
    <div class="alert alert--success">Тема удалена. Слова остались в словаре.</div>
}

@if (Error is not null)
{
    <div class="alert alert--error">@(Error == "expired" ? "Форма устарела. Повторите действие." : Error)</div>
}

<p class="muted">
    Темы задают фильтр на главной странице. Пустые темы гостю не показываются.
</p>

<form class="form" method="post" action="/admin/api/categories" style="max-width:520px">
    <AntiforgeryToken />

    <div class="field">
        <label class="field__label" for="new-category">Новая тема</label>
        <input id="new-category" type="text" name="name" required maxlength="100" placeholder="Например: Транспорт" />
    </div>

    <div class="field">
        <label class="field__label" for="new-order">Порядок</label>
        <input id="new-order" type="number" name="sortOrder" value="0" />
        <span class="field__hint">Меньше — левее в списке фильтров.</span>
    </div>

    <div>
        <button class="button button--primary" type="submit">Добавить</button>
    </div>
</form>

@if (_categories.Count > 0)
{
    <div class="table-wrapper" style="margin-top:1.5rem">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Порядок</th>
                    <th>Слов</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in _categories)
                {
                    <tr>
                        <td>
                            @* Каждая строка — самостоятельная форма: правка одной темы
                               не требует отправлять весь список. *@
                            <form class="inline-form" method="post" action="/admin/api/categories" id="category-@category.Id">
                                <AntiforgeryToken />
                                <input type="hidden" name="id" value="@category.Id" />
                                <input type="text" name="name" value="@category.Name" required maxlength="100" />
                            </form>
                        </td>
                        <td>
                            <input type="number" name="sortOrder" value="@category.SortOrder"
                                   form="category-@category.Id" style="width:5rem" />
                        </td>
                        <td>@category.WordCount</td>
                        <td class="nowrap">
                            <button class="button button--small" type="submit" form="category-@category.Id">Сохранить</button>
                            <form class="inline-form" method="post" action="/admin/api/categories/@category.Id/delete"
                                  onsubmit="return confirm('Удалить тему «@category.Name»? Слова останутся в словаре.')">
                                <AntiforgeryToken />
                                <button class="button button--small button--danger" type="submit">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<AdminCategory> _categories = [];

    [SupplyParameterFromQuery(Name = "saved")]
    public string? SavedValue { get; set; }

    [SupplyParameterFromQuery(Name = "deleted")]
    public string? DeletedValue { get; set; }

    private bool Saved => QueryValues.IsSet(SavedValue);

    private bool Deleted => QueryValues.IsSet(DeletedValue);

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    protected override async Task OnParametersSetAsync() =>
        _categories = await CategoryService.ListAsync();
}
