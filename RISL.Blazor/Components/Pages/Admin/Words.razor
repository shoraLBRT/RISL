@page "/admin/words"
@layout AdminLayout
@using RISL.Blazor.Security
@attribute [Authorize(Policy = AdminAuthentication.Policy)]
@inject IWordAdminService WordService

<PageTitle>Слова — панель словаря</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<h1>Слова</h1>

@if (Deleted)
{
    <div class="alert alert--success">Слово удалено вместе с его файлами.</div>
}

@if (Error is not null)
{
    <div class="alert alert--error">@(Error == "expired" ? "Форма устарела. Повторите действие." : Error)</div>
}

<form class="search" method="get" action="/admin/words" data-search-form>
    <label class="visually-hidden" for="admin-search">Поиск по словам и описаниям</label>
    <input id="admin-search" class="search__input" type="text" name="q" value="@Query"
           placeholder="Слово или фрагмент описания" autocomplete="off" data-search-input />
    @if (Filter != AdminWordFilter.All)
    {
        <input type="hidden" name="filter" value="@Filter" />
    }
    <button class="button button--primary search__submit" type="submit">Найти</button>
</form>

<div class="chips" role="group" aria-label="Фильтры">
    @foreach (var (filter, title) in Filters)
    {
        <a class="chip @(filter == Filter ? "chip--active" : null)" href="@FilterUrl(filter)">@title</a>
    }
</div>

<div class="toolbar" style="margin-top:1rem">
    <span class="muted">Найдено: @_page.TotalCount</span>
    <span class="toolbar__spacer"></span>
    <a class="button button--primary" href="/admin/words/new">Добавить слово</a>
</div>

@if (_page.Items.Count == 0)
{
    <div class="empty-state">Ничего не нашлось.</div>
}
else
{
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th><a class="table__sort" href="@SortUrl(AdminWordSort.Word)">Слово @SortMark(AdminWordSort.Word)</a></th>
                    <th>Описание</th>
                    <th>Темы</th>
                    <th><a class="table__sort" href="@SortUrl(AdminWordSort.Status)">Видео @SortMark(AdminWordSort.Status)</a></th>
                    <th>Публикация</th>
                    <th><a class="table__sort" href="@SortUrl(AdminWordSort.Views)">Просмотры @SortMark(AdminWordSort.Views)</a></th>
                    <th><a class="table__sort" href="@SortUrl(AdminWordSort.Updated)">Изменено @SortMark(AdminWordSort.Updated)</a></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var word in _page.Items)
                {
                    <tr>
                        <td><a href="/admin/words/@word.Id">@word.Text</a></td>
                        <td class="muted">@Shorten(word.Description)</td>
                        <td class="muted">@string.Join(", ", word.Categories)</td>
                        <td><VideoStatusBadge Status="word.VideoStatus" /></td>
                        <td>
                            @if (word.IsPublished)
                            {
                                <span class="badge badge--ready">Да</span>
                            }
                            else
                            {
                                <span class="badge badge--none">Черновик</span>
                            }
                        </td>
                        <td>@word.ViewCount</td>
                        <td class="nowrap muted">@word.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="nowrap">
                            <a class="button button--small" href="/admin/words/@word.Id">Открыть</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pagination Page="_page.Page" TotalPages="_page.TotalPages" BasePath="/admin/words" Query="CurrentQuery" />
}

@code {
    private static readonly (AdminWordFilter Filter, string Title)[] Filters =
    [
        (AdminWordFilter.All, "Все"),
        (AdminWordFilter.Visible, "Видны гостям"),
        (AdminWordFilter.Hidden, "Скрыты"),
        (AdminWordFilter.Failed, "Ошибки видео"),
        (AdminWordFilter.WithoutVideo, "Без видео"),
    ];

    private AdminWordPage _page = new([], 0, 1, AdminWordQuery.DefaultPageSize);

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    // Blazor умеет доставать из строки запроса только простые типы, перечисления
    // в этот список не входят, поэтому разбираем их вручную.
    [SupplyParameterFromQuery(Name = "filter")]
    public string? FilterValue { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortValue { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public string? DescendingValue { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public string? PageValue { get; set; }

    [SupplyParameterFromQuery(Name = "deleted")]
    public string? DeletedValue { get; set; }

    private bool Deleted => QueryValues.IsSet(DeletedValue);

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private AdminWordFilter Filter =>
        Enum.TryParse<AdminWordFilter>(FilterValue, ignoreCase: true, out var filter) ? filter : AdminWordFilter.All;

    private AdminWordSort Sort =>
        Enum.TryParse<AdminWordSort>(SortValue, ignoreCase: true, out var sort) ? sort : AdminWordSort.Updated;

    // По датам и просмотрам естественнее смотреть сверху вниз, по словам — от «а».
    private static bool DefaultDescending(AdminWordSort sort) =>
        sort is AdminWordSort.Updated or AdminWordSort.Views;

    private bool IsDescending => QueryValues.ToBool(DescendingValue) ?? DefaultDescending(Sort);

    protected override async Task OnParametersSetAsync() =>
        _page = await WordService.ListAsync(new AdminWordQuery
        {
            Search = Query,
            Filter = Filter,
            Sort = Sort,
            Descending = IsDescending,
            Page = QueryValues.ToPage(PageValue),
        });

    private IReadOnlyDictionary<string, string?> CurrentQuery => new Dictionary<string, string?>
    {
        ["q"] = Query,
        ["filter"] = Filter == AdminWordFilter.All ? null : Filter.ToString(),
        ["sort"] = Sort.ToString(),
        ["desc"] = IsDescending.ToString().ToLowerInvariant(),
    };

    private string FilterUrl(AdminWordFilter filter) => BuildUrl(filter, Sort, IsDescending);

    /// <summary>Повторный клик по колонке переворачивает порядок сортировки.</summary>
    private string SortUrl(AdminWordSort sort) =>
        BuildUrl(Filter, sort, Sort == sort ? !IsDescending : DefaultDescending(sort));

    private string? SortMark(AdminWordSort sort) => Sort == sort ? (IsDescending ? "↓" : "↑") : null;

    private string BuildUrl(AdminWordFilter filter, AdminWordSort sort, bool descending)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(Query))
        {
            parts.Add($"q={Uri.EscapeDataString(Query)}");
        }

        if (filter != AdminWordFilter.All)
        {
            parts.Add($"filter={filter}");
        }

        parts.Add($"sort={sort}");
        parts.Add($"desc={descending.ToString().ToLowerInvariant()}");

        return $"/admin/words?{string.Join('&', parts)}";
    }

    private static string Shorten(string value) =>
        value.Length <= 90 ? value : value[..87] + "…";
}
