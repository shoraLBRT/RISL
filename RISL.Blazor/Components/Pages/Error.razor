@page "/error"
@using System.Diagnostics

<PageTitle>Ошибка</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<h1>Что-то пошло не так</h1>

<p class="muted">
    Запрос не удалось обработать. Попробуйте повторить действие, а если ошибка
    повторяется — <a href="/feedback">сообщите нам</a>.
</p>

@if (ShowRequestId)
{
    @* Идентификатор помогает найти этот запрос в логах сервера. *@
    <p>Код обращения: <code>@RequestId</code></p>
}

<p>
    <a class="button button--primary" href="/">Вернуться к словарю</a>
</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
